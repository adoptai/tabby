    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "overrides": {
      "ajv@6": "^6.14.0",
      "ajv@8": "^8.18.0",
      "axios": ">=1.15.2",
      "@babel/core@7": "^7.29.6",
